{
  "name": "aurix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "npx tsc -p electron/tsconfig.json",
    "dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && cross-env NEXT_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build": "next build",
    "electron:build": "next build && tsc -p electron/tsconfig.json && electron-builder",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.3.0",
    "@google-cloud/storage": "^7.19.0",
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "lodash": "^4.17.21",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-electron-server": "^1.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.aurix.voiceassistant",
    "productName": "AURIX Voice Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist-next/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "@tootallnate/once": "^3.0.1"
  }
}

{
  "name": "aurix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "npx tsc -p electron/tsconfig.json",
    "dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && cross-env NEXT_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build": "next build",
    "electron:build": "next build && tsc -p electron/tsconfig.json && electron-builder",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-serve": "^3.0.1",
    "next": "16.2.1",
    "next-electron-server": "^1.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "build": {
    "appId": "com.aurix.voiceassistant",
    "productName": "AURIX Voice Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist-next/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  }
}
